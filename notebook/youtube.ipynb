    "    \n",
    "    if \"watch?v=\" in url:\n",
    "        return url.split(\"v=\")[-1]\n",
    "    elif \"youtu.be\" in url:\n",
    "        return url.split(\"/\")[-1]\n",
    "    else:\n",
    "        return video_id"
